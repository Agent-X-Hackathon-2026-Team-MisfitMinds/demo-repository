{
  "name": "fixie",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agent-X-Hackathon-2026-Team-MisfitMinds/demo-repository.git"
  },
  "homepage": "https://github.com/Agent-X-Hackathon-2026-Team-MisfitMinds/demo-repository#readme",
  "bugs": {
    "url": "https://github.com/Agent-X-Hackathon-2026-Team-MisfitMinds/demo-repository/issues"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . && node scripts/check-secret-imports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-secret-imports.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "eslint-plugin-security": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,yaml}": "prettier --write"
  }
}
